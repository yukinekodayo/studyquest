{
  "name": "studyquest",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "stack": "node scripts/local-stack/start.mjs",
    "assets": "node scripts/make-assets.mjs",
    "web:export": "expo export -p web --output-dir dist --clear",
    "web:serve": "node scripts/e2e/serve.mjs 8081",
    "e2e:phase1": "node scripts/e2e/phase1.mjs",
    "e2e:phase2": "node scripts/e2e/phase2.mjs",
    "setup-sql": "node scripts/build-setup-sql.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "0.4.2",
    "@expo-google-fonts/noto-sans-jp": "0.4.3",
    "@expo-google-fonts/shippori-mincho": "0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.26",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2",
    "pg": "^8.23.0",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9",
    "vitest": "^5.0.2"
  }
}
